{
    "$schema":  "https://opencode.ai/config.json",
    "plugin":  [
                   "./.opencode/plugin/klia-auto-record.js",
                   "./.opencode/plugin/openrtk.js",
                   "./.opencode/plugin/force-norms.js"
               ],
    "mcp":  {
                "klia-token-optimizer":  {
                                             "type":  "local",
                                             "command":  [
                                                             "node",
                                                             "C:/ProyectosV2/telemetria/klia-token-optimizer - copia/dist/mcp-server.js"
                                                         ],
                                             "enabled":  true,
                                             "environment":  {
                                                                 "ROUTER_HISTORY_PATH":  "C:/ProyectosV2/telemetria/klia-token-optimizer - copia/data/history.json",
                                                                 "ROUTER_METRICS_PATH":  "C:/ProyectosV2/telemetria/klia-token-optimizer - copia/data/mcp-metrics.json",
                                                                 "ROUTER_EVENTS_PATH":  "C:/ProyectosV2/telemetria/klia-token-optimizer - copia/data/events.json",
                                                                 "ROUTER_MIN_CONFIDENCE":  "0.6",
                                                                 "ROUTER_EXPLORATION_RATE":  "0.1",
                                                                 "ROUTER_MIN_SAMPLES":  "3"
                                                             }
                                         },
                "semble":  {
                               "type":  "local",
                               "command":  [
                                               "uvx",
                                               "--from",
                                               "semble[mcp]==0.5.5",
                                               "semble"
                                           ],
                               "enabled":  true,
                               "environment":  {

                                               }
                           },
                "repomix":  {
                                "type":  "local",
                                "command":  [
                                                "npx",
                                                "-y",
                                                "repomix",
                                                "--mcp"
                                            ],
                                "enabled":  true,
                                "environment":  {

                                                }
                            },
                "serena":  {
                               "type":  "local",
                               "command":  [
                                               "serena",
                                               "start-mcp-server",
                                               "--context",
                                               "ide"
                                           ],
                               "enabled":  true,
                               "environment":  {

                                               }
                           }
            }
}
