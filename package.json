{
  "name": "klia-token-optimizer",
  "version": "2.0.0",
  "description": "Router adaptativo de optimizadores de contexto para OpenCode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "route": "tsx src/cli.ts",
    "calibrate": "tsx src/scripts/calibrate.ts",
    "mcp-server": "tsx src/mcp-server.ts",
    "router": "tsx src/router-cli.ts",
    "benchmark": "tsx pruebas_v2/src/orchestrator.ts pilot",
    "benchmark:smoke": "tsx pruebas_v2/src/orchestrator.ts smoke",
    "benchmark:full": "tsx pruebas_v2/src/orchestrator.ts pilot --treatment OPTIMIZED_V2",
    "benchmark:preflight": "tsx pruebas_v2/src/orchestrator.ts preflight",
    "benchmark:run": "tsx pruebas_v2/src/orchestrator.ts run",
    "benchmark:report": "tsx pruebas_v2/src/orchestrator.ts report",
    "benchmark:v3": "tsx pruebas_v3/run-benchmark-v3.ts",
    "benchmark:honest": "tsx pruebas_v3/run-benchmark-honesto.ts",
    "benchmark:real": "tsx pruebas_v3/run-benchmark-real.ts",
    "benchmark:adversarial": "tsx pruebas_v3/run-benchmark-adversarial.ts",
    "benchmark:max-real": "tsx pruebas_v3/run-benchmark-max-real.ts",
    "benchmark:diverse": "tsx pruebas_v3/run-benchmark-diverse.ts",
    "benchmark:sim": "tsx pruebas_v3/run-session-sim.ts",
    "benchmark:random-lab": "tsx pruebas_v3/run-random-lab.ts",
    "benchmark:e2e": "tsx pruebas_v3/run-e2e.ts",
    "test:integrity": "vitest run pruebas_v2/tests"
  },
  "keywords": [
    "opencode",
    "router",
    "context-optimization"
  ],
  "author": "Klia Token Optimizer contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josedelacruz-rgb/klia-token-optimizer.git"
  },
  "homepage": "https://github.com/josedelacruz-rgb/klia-token-optimizer#readme",
  "bugs": {
    "url": "https://github.com/josedelacruz-rgb/klia-token-optimizer/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
}
